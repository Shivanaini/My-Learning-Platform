
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        booleanParam(
            name: 'RUN_APPLY',
            defaultValue: false,
            description: 'Apply Terraform changes after reviewing the plan'
        )

        booleanParam(
            name: 'RUN_DESTROY',
            defaultValue: false,
            description: 'Destroy AWS infrastructure after reviewing and approving the destroy plan'
        )
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-southeast-2'
        AWS_REGION         = 'ap-southeast-2'
        TF_IN_AUTOMATION   = 'true'
    }

    stages {

        stage('Validate Parameters') {
            steps {
                script {
                    if (params.RUN_APPLY && params.RUN_DESTROY) {
                        error('RUN_APPLY and RUN_DESTROY cannot both be true. Select only one.')
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Format Check') {
            steps {
                dir('learning-platform-infra-repo') {
                    sh 'terraform fmt -check -recursive'
                }
            }
        }

        stage('Terraform Init') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    dir('learning-platform-infra-repo/environments/dev') {
                        sh '''
                            set +x
                            terraform init -input=false
                        '''
                    }
                }
            }
        }

        stage('Import Existing Secrets') {
            steps {
                dir('learning-platform-infra-repo/environments/dev') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-credentials',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        ),
                        file(
                            credentialsId: 'dev-tfvars',
                            variable: 'TFVARS_FILE'
                        )
                    ]) {
                        sh '''
                            set -e
                            set +x

                            export AWS_DEFAULT_REGION=ap-southeast-2

                            if terraform state list | grep -Fxq 'module.secrets_manager.aws_secretsmanager_secret.database'; then
                                echo "Database secret already imported. Skipping."
                            else
                                terraform import -input=false \
                                  -var-file="$TFVARS_FILE" \
                                  'module.secrets_manager.aws_secretsmanager_secret.database' \
                                  'arn:aws:secretsmanager:ap-southeast-2:709604006144:secret:learning-platform/dev/database-zj8Q0B'
                            fi

                            if terraform state list | grep -Fxq 'module.secrets_manager.aws_secretsmanager_secret.jwt'; then
                                echo "JWT secret already imported. Skipping."
                            else
                                terraform import -input=false \
                                  -var-file="$TFVARS_FILE" \
                                  'module.secrets_manager.aws_secretsmanager_secret.jwt' \
                                  'arn:aws:secretsmanager:ap-southeast-2:709604006144:secret:learning-platform/dev/jwt-9sURUD'
                            fi
                        '''
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('learning-platform-infra-repo/environments/dev') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            when {
                expression {
                    return !params.RUN_DESTROY
                }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    ),
                    file(
                        credentialsId: 'dev-tfvars',
                        variable: 'TFVARS_FILE'
                    )
                ]) {
                    dir('learning-platform-infra-repo/environments/dev') {
                        sh '''
                            set +x

                            aws sts get-caller-identity

                            terraform state list

                            terraform plan \
                                -input=false \
                                -var-file="$TFVARS_FILE" \
                                -out=tfplan
                        '''
                    }
                }
            }
        }

        stage('Terraform Approval') {
            when {
                expression {
                    return params.RUN_APPLY
                }
            }

            steps {
                input(
                    message: 'Review the Terraform plan. Approve infrastructure changes?',
                    ok: 'Approve Apply'
                )
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    return params.RUN_APPLY
                }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    dir('learning-platform-infra-repo/environments/dev') {
                        sh '''
                            set +x
                            terraform apply -input=false tfplan
                        '''
                    }
                }
            }
        }

        stage('Terraform Destroy Plan') {
            when {
                expression {
                    return params.RUN_DESTROY
                }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    ),
                    file(
                        credentialsId: 'dev-tfvars',
                        variable: 'TFVARS_FILE'
                    )
                ]) {
                    dir('learning-platform-infra-repo/environments/dev') {
                        sh '''
                            set +x

                            aws sts get-caller-identity

                            terraform state list

                            terraform plan \
                                -destroy \
                                -input=false \
                                -var-file="$TFVARS_FILE" \
                                -out=tfdestroyplan

                            echo "Destroy plan generated successfully."
                        '''
                    }
                }
            }
        }

        stage('Terraform Destroy Approval') {
            when {
                expression {
                    return params.RUN_DESTROY
                }
            }

            steps {
                input(
                    message: 'WARNING: This will destroy the AWS infrastructure. Have you reviewed the destroy plan and confirmed that important data is backed up?',
                    ok: 'Approve Terraform Destroy'
                )
            }
        }

        stage('Terraform Destroy') {
            when {
                expression {
                    return params.RUN_DESTROY
                }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    dir('learning-platform-infra-repo/environments/dev') {
                        sh '''
                            set +x
                            terraform apply -input=false tfdestroyplan
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Terraform pipeline completed successfully.'
        }

        failure {
            echo 'Terraform pipeline failed. Check Jenkins console output.'
        }

        always {
            echo 'Terraform pipeline execution finished.'
        }
    }
}
