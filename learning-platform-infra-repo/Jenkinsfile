
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        booleanParam(
            name: 'RUN_APPLY',
            defaultValue: false,
            description: 'Apply Terraform changes after reviewing the plan'
        )
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
        AWS_REGION         = 'ap-south-1'
        TF_IN_AUTOMATION   = 'true'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Format Check') {
            steps {
                dir('learning-platform-infra-repo') {
                    sh 'terraform fmt -check -recursive'
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir('learning-platform-infra-repo/environments/dev') {
                    sh 'terraform init -input=false'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('learning-platform-infra-repo/environments/dev') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    ),
                    file(
                        credentialsId: 'dev-tfvars',
                        variable: 'TFVARS_FILE'
                    )
                ]) {
                    dir('learning-platform-infra-repo/environments/dev') {
                        sh '''
                            set +x

                            aws sts get-caller-identity

                            terraform plan \
                                -input=false \
                                -var-file="$TFVARS_FILE" \
                                -out=tfplan
                        '''
                    }
                }
            }
        }

        stage('Terraform Approval') {
            when {
                expression {
                    return params.RUN_APPLY
                }
            }

            steps {
                input(
                    message: 'Review the Terraform plan. Approve infrastructure changes?',
                    ok: 'Approve Apply'
                )
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    return params.RUN_APPLY
                }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    dir('learning-platform-infra-repo/environments/dev') {
                        sh '''
                            set +x
                            terraform apply -input=false tfplan
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Terraform pipeline completed successfully.'
        }

        failure {
            echo 'Terraform pipeline failed. Check Jenkins console output.'
        }

        always {
            echo 'Terraform pipeline execution finished.'
        }
    }
}
